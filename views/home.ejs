<!doctype html>
<html><head><meta charset="utf-8"><title>Dashboard</title><link rel="stylesheet" href="/styles.css"></head>
<body>
<%- include('_header') %>
<div class="container container--home">
  <h2>Dashboard</h2>

  <nav class="home-nav-grid" aria-label="Quick navigation">
    <a class="home-card" href="/customer/add">
      <span class="home-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
      </span>
      <span class="home-card__label">Add Customer</span>
      <span class="home-card__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M10 8l4 4-4 4"/></svg>
      </span>
    </a>
    <a class="home-card" href="/customers">
      <span class="home-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <span class="home-card__label">Customers</span>
      <span class="home-card__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M10 8l4 4-4 4"/></svg>
      </span>
    </a>
    <a class="home-card" href="/items">
      <span class="home-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
      </span>
      <span class="home-card__label">Items</span>
      <span class="home-card__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M10 8l4 4-4 4"/></svg>
      </span>
    </a>
    <a class="home-card" href="/subscriptions">
      <span class="home-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
      </span>
      <span class="home-card__label">Subscriptions</span>
      <span class="home-card__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M10 8l4 4-4 4"/></svg>
      </span>
    </a>
    <a class="home-card" href="/billing/form">
      <span class="home-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="M9 15h6"/></svg>
      </span>
      <span class="home-card__label">Billing</span>
      <span class="home-card__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M10 8l4 4-4 4"/></svg>
      </span>
    </a>
    <a class="home-card" href="/reports">
      <span class="home-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      </span>
      <span class="home-card__label">Reports</span>
      <span class="home-card__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M10 8l4 4-4 4"/></svg>
      </span>
    </a>
    <a class="home-card" href="/settings">
      <span class="home-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </span>
      <span class="home-card__label">Settings</span>
      <span class="home-card__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M10 8l4 4-4 4"/></svg>
      </span>
    </a>
  </nav>

  <section class="home-stats">
    <h3 class="home-stats__title">Overview</h3>
    <div class="home-stats__grid">
      <div class="home-stat"><span class="home-stat__value"><%= stats.customers %></span><span class="home-stat__key">Total customers</span></div>
      <div class="home-stat"><span class="home-stat__value"><%= stats.active_subscriptions %></span><span class="home-stat__key">Active subscriptions</span></div>
      <button type="button" class="home-stat home-stat--clickable" id="pending-month-tile" data-month="<%= monthKey %>" aria-haspopup="dialog" aria-controls="pending-modal">
        <span class="home-stat__value">₹<%= stats.current_month_pending %></span>
        <span class="home-stat__key">Pending this month</span>
      </button>
    </div>
  </section>

  <div id="pending-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="pending-modal-title" hidden>
    <div class="modal__backdrop" data-close-modal tabindex="-1"></div>
    <div class="modal__panel">
      <div class="modal__header">
        <h3 id="pending-modal-title">Pending this month <span id="pending-modal-month-label" class="pending-modal__month"></span></h3>
        <button type="button" class="modal__close" data-close-modal aria-label="Close">&times;</button>
      </div>
      <div class="modal__body">
        <p id="pending-modal-loading" class="modal__loading">Loading…</p>
        <p id="pending-modal-empty" class="modal__empty" hidden>No pending balances for this month.</p>
        <div id="pending-modal-table-wrap" class="table-wrap" hidden>
          <table class="data-table" id="pending-modal-table">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Mobile</th>
                <th>Subscription</th>
                <th>Balance</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="pending-modal-tbody"></tbody>
          </table>
        </div>
        <div id="pending-modal-pagination" class="table-pagination table-pagination--modal" hidden>
          <p id="pending-modal-page-summary" class="table-pagination__summary"></p>
          <div class="table-pagination__nav">
            <button type="button" class="table-pagination__link" id="pending-page-prev">Previous</button>
            <span id="pending-modal-page-meta" class="table-pagination__pages"></span>
            <button type="button" class="table-pagination__link" id="pending-page-next">Next</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
(function () {
  var tile = document.getElementById('pending-month-tile');
  var modal = document.getElementById('pending-modal');
  if (!tile || !modal) return;
  var month = tile.getAttribute('data-month') || '';
  var loading = document.getElementById('pending-modal-loading');
  var empty = document.getElementById('pending-modal-empty');
  var wrap = document.getElementById('pending-modal-table-wrap');
  var tbody = document.getElementById('pending-modal-tbody');
  var monthLabel = document.getElementById('pending-modal-month-label');
  var lastFocus = null;
  var pendingPage = 1;
  var pendingRowsAll = [];
  var PENDING_PAGE_SIZE = 10;
  var pagWrap = document.getElementById('pending-modal-pagination');
  var pagSummary = document.getElementById('pending-modal-page-summary');
  var pagMeta = document.getElementById('pending-modal-page-meta');
  var btnPrev = document.getElementById('pending-page-prev');
  var btnNext = document.getElementById('pending-page-next');

  function esc(s) {
    var d = document.createElement('div');
    d.textContent = s == null ? '' : String(s);
    return d.innerHTML;
  }

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }

  function openModal() {
    lastFocus = document.activeElement;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    monthLabel.textContent = '(' + month + ')';
    loading.textContent = 'Loading…';
    loading.hidden = false;
    empty.hidden = true;
    wrap.hidden = true;
    if (pagWrap) pagWrap.hidden = true;
    tbody.innerHTML = '';
    pendingRowsAll = [];
    pendingPage = 1;

    var closeBtn = modal.querySelector('.modal__close');
    requestAnimationFrame(function () {
      if (closeBtn && typeof closeBtn.focus === 'function') closeBtn.focus();
    });

    fetch('/home/pending-details?month=' + encodeURIComponent(month), { credentials: 'same-origin' })
      .then(function (r) {
        if (!r.ok) throw new Error('Failed to load');
        return r.json();
      })
      .then(function (data) {
        loading.hidden = true;
        var rows = data.rows || [];
        if (rows.length === 0) {
          empty.hidden = false;
          return;
        }
        pendingRowsAll = rows;
        pendingPage = 1;
        renderPendingPage();
      })
      .catch(function () {
        loading.textContent = 'Could not load details. Try again.';
      });
  }

  function renderPendingPage() {
    var total = pendingRowsAll.length;
    if (!total) return;
    var totalPages = Math.max(1, Math.ceil(total / PENDING_PAGE_SIZE));
    if (pendingPage > totalPages) pendingPage = totalPages;
    if (pendingPage < 1) pendingPage = 1;
    var start = (pendingPage - 1) * PENDING_PAGE_SIZE;
    var slice = pendingRowsAll.slice(start, start + PENDING_PAGE_SIZE);
    wrap.hidden = false;
    tbody.innerHTML = slice.map(function (row) {
      var pid = parseInt(row.payment_id, 10);
      if (!isFinite(pid)) pid = 0;
      return '<tr>' +
        '<td>' + esc(row.customer_name) + '</td>' +
        '<td>' + esc(row.customer_mobile) + '</td>' +
        '<td>' + esc(row.subscription_name) + '</td>' +
        '<td>₹' + esc(row.balance) + '</td>' +
        '<td><a href="/payment/' + pid + '">View</a></td>' +
        '</tr>';
    }).join('');
    if (pagWrap && pagSummary && pagMeta && btnPrev && btnNext) {
      if (totalPages <= 1) {
        pagWrap.hidden = true;
      } else {
        pagWrap.hidden = false;
        pagSummary.textContent = 'Showing ' + (start + 1) + '–' + Math.min(start + PENDING_PAGE_SIZE, total) + ' of ' + total;
        pagMeta.textContent = 'Page ' + pendingPage + ' of ' + totalPages;
        btnPrev.disabled = pendingPage <= 1;
        btnNext.disabled = pendingPage >= totalPages;
        pagMeta.style.display = '';
        btnPrev.style.display = '';
        btnNext.style.display = '';
      }
    }
  }

  tile.addEventListener('click', openModal);

  if (btnPrev) btnPrev.addEventListener('click', function () {
    if (pendingPage > 1) {
      pendingPage--;
      renderPendingPage();
    }
  });
  if (btnNext) btnNext.addEventListener('click', function () {
    var totalPages = Math.max(1, Math.ceil(pendingRowsAll.length / PENDING_PAGE_SIZE));
    if (pendingPage < totalPages) {
      pendingPage++;
      renderPendingPage();
    }
  });

  modal.querySelectorAll('[data-close-modal]').forEach(function (el) {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
})();
</script>
</body></html>
