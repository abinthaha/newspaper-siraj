<!doctype html>
<html><head><meta charset="utf-8"><title>Delivery</title><link rel="stylesheet" href="/styles.css"></head>
<body>
<%- include('_header') %>
<div class="container">
  <a class="back-link" href="/home">Back</a>
  <h2>Delivery boys</h2>
  <% if (!boys || !boys.length) { %>
    <% if (typeof pagination !== 'undefined' && pagination && pagination.total > 0) { %>
      <p class="billing-summary__empty">No rows on this page. <a href="<%= pagination.firstUrl %>">Go to first page</a></p>
    <% } else { %>
      <p class="form-hint">No delivery boys in the database yet.</p>
    <% } %>
  <% } else { %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr><th>Name</th><th>Mobile</th></tr>
      </thead>
      <tbody>
        <% boys.forEach(function (b) { %>
          <tr>
            <td><%= b.name || '—' %></td>
            <td><%= b.mobile || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('_pagination', { pagination: typeof pagination !== 'undefined' ? pagination : null }) %>
  <% } %>
</div>
</body></html>
