<% const editItem = locals.editItem == null ? null : locals.editItem; %>
<% const editingItem = editItem != null; %>
<% const activeSubCount = (locals.activeSubCount == null || locals.activeSubCount === '') ? 0 : Number(locals.activeSubCount); %>
<!doctype html>
<html><head><meta charset="utf-8"><title>Items</title><link rel="stylesheet" href="/styles.css"></head>
<body>
<%- include('_header') %>
<div class="container">
  <a class="back-link" href="/home">Back</a>
  <h2>Items</h2>
  <form id="item-form" method="POST" data-active-subs="<%= activeSubCount %>" data-item-was-active="<%= editingItem && Number(editItem.active) !== 0 ? '1' : '0' %>" action="<%= editingItem ? '/items/edit/' + editItem.id : '/items' %>">
    <input type="hidden" name="remove_linked_subscriptions" value="0" id="remove_linked_subscriptions">
    <label>Name</label><input name="name" required value="<%= editingItem ? editItem.name : '' %>">
    <label>Type</label>
    <select name="item_type">
      <option value="newspaper" <%= editingItem && editItem.item_type === 'newspaper' ? 'selected' : '' %>>Newspaper</option>
      <option value="magazine" <%= editingItem && editItem.item_type === 'magazine' ? 'selected' : '' %>>Magazine</option>
    </select>
    <label>Monthly Rate</label><input name="monthly_rate" type="number" value="<%= editingItem ? editItem.monthly_rate : 295 %>">
    <label>Status</label>
    <select name="active" id="item-active">
      <option value="1" <%= !editingItem || Number(editItem.active) !== 0 ? 'selected' : '' %>>Active</option>
      <option value="0" <%= editingItem && Number(editItem.active) === 0 ? 'selected' : '' %>>Inactive</option>
    </select>
    <button type="submit"><%= editingItem ? 'Update Item' : 'Save Item' %></button>
    <% if (editingItem) { %>
      <p style="margin-top:12px;"><a href="/items">Cancel edit</a></p>
    <% } %>
  </form>

  <h3>Existing Items</h3>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr><th>Name</th><th>Type</th><th>Monthly</th><th>Status</th><th>Action</th></tr>
      </thead>
      <tbody>
        <% items.forEach(it => { %>
          <tr>
            <td><%= it.name %></td>
            <td><span class="badge badge--info"><%= it.item_type %></span></td>
            <td>₹<%= it.monthly_rate %></td>
            <td>
              <% if (Number(it.active) === 0) { %>
                <span class="badge badge--danger">Inactive</span>
              <% } else { %>
                <span class="badge badge--success">Active</span>
              <% } %>
            </td>
            <td><a href="/items?edit=<%= it.id %>">Edit</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<script>
(function () {
  var form = document.getElementById('item-form');
  if (!form) return;
  form.addEventListener('submit', function (e) {
    var activeSel = document.getElementById('item-active');
    var rem = document.getElementById('remove_linked_subscriptions');
    if (!activeSel || !rem) return;
    var n = parseInt(form.getAttribute('data-active-subs') || '0', 10) || 0;
    var wasActive = form.getAttribute('data-item-was-active') === '1';
    if (activeSel.value !== '0' || n < 1 || !wasActive) return;
    if (rem.value === '1') return;
    var msg = 'This item has ' + n + ' active subscription(s). Making it Inactive will stop those subscriptions for all affected customers. Continue?';
    if (!window.confirm(msg)) {
      e.preventDefault();
      return;
    }
    rem.value = '1';
  });
})();
</script>
</body></html>
