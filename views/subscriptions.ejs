<!doctype html>
<html><head><meta charset="utf-8"><title>Subscriptions</title><link rel="stylesheet" href="/styles.css"></head>
<body>
<div class="container">
  <a href="/home">Back</a>
  <h2>Subscriptions</h2>
  <table>
    <tr><th>Customer</th><th>Item</th><th>Monthly</th><th>Annual</th><th>Sunday-only</th></tr>
    <% subscriptions.forEach(s => { %>
      <tr>
        <td><%= s.customer_name %></td>
        <td><%= s.item_name %></td>
        <td>₹<%= s.monthly_rate %></td>
        <td><%= s.is_annual ? 'Yes' : 'No' %></td>
        <td><%= s.is_sunday_only ? 'Yes' : 'No' %></td>
      </tr>
    <% }) %>
  </table>
</div>
</body></html>