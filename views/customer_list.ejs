<% const q = typeof searchQuery !== 'undefined' ? searchQuery : ''; %>
<% const filterArea = typeof locals.filterArea !== 'undefined' ? locals.filterArea : ''; %>
<% const filterRoute = typeof locals.filterRoute !== 'undefined' ? locals.filterRoute : ''; %>
<% const areaOptions = locals.areaOptions || []; %>
<% const routeOptions = locals.routeOptions || []; %>
<% const hasFilters = !!(q || filterArea || filterRoute); %>
<!doctype html>
<html><head><meta charset="utf-8"><title>Customers</title><link rel="stylesheet" href="/styles.css"></head>
<body>
<%- include('_header') %>
<div class="container container--customer-list">
  <a class="back-link" href="/home">Back</a>
  <h2>Customers</h2>

  <form class="customer-list__search" method="get" action="/customers" role="search">
    <div class="customer-list__toolbar" role="group" aria-label="Search and filter customers">
      <input type="search" id="customer-search-q" name="q" value="<%= q %>" placeholder="Name or mobile" autocomplete="off" maxlength="80" aria-label="Search by name or mobile">
      <div class="customer-list__toolbar-field">
        <label for="customer-filter-area">Area</label>
        <select id="customer-filter-area" name="area">
          <option value="">All areas</option>
          <% areaOptions.forEach(function (a) { %>
            <option value="<%= a %>"<%= filterArea === a ? ' selected' : '' %>><%= a %></option>
          <% }); %>
        </select>
      </div>
      <div class="customer-list__toolbar-field">
        <label for="customer-filter-route">Route</label>
        <select id="customer-filter-route" name="route">
          <option value="">All routes</option>
          <% routeOptions.forEach(function (r) { %>
            <option value="<%= r %>"<%= filterRoute === r ? ' selected' : '' %>><%= r %></option>
          <% }); %>
        </select>
      </div>
      <% if (hasFilters) { %>
        <a class="customer-list__clear" href="/customers">Clear</a>
      <% } %>
      <button type="submit" class="customer-list__toolbar-submit">Search</button>
    </div>
  </form>

  <% if (hasFilters) { %>
    <p class="customer-list__hint"><%= (typeof pagination !== 'undefined' && pagination) ? pagination.total : customers.length %> match<%= ((typeof pagination !== 'undefined' && pagination) ? pagination.total : customers.length) === 1 ? '' : 'es' %><% if (q) { %> for "<%= q %>"<% } %><% if (filterArea) { %> · Area: <%= filterArea %><% } %><% if (filterRoute) { %> · Route: <%= filterRoute %><% } %>.</p>
  <% } %>

  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Mobile</th>
          <th>Area</th>
          <th>Route</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (!customers.length) { %>
          <tr>
            <td colspan="6" class="customer-list__empty"><%= hasFilters ? 'No customers match your search or filters.' : 'No customers yet.' %></td>
          </tr>
        <% } else { %>
          <% customers.forEach(c=>{ %>
            <tr>
              <td><%= c.name %></td>
              <td><%= c.mobile %></td>
              <td><%= c.area_name || '—' %></td>
              <td><%= c.route_name || '—' %></td>
              <td>
                <% if (Number(c.active) === 0) { %>
                  <span class="badge badge--danger">Inactive</span>
                <% } else { %>
                  <span class="badge badge--success">Active</span>
                <% } %>
              </td>
              <td><a href="/customer/view/<%= c.id %>">View</a> · <a href="/customer/add?edit=<%= c.id %>">Edit</a> · <a href="/subscription/add/<%= c.id %>">Add subscription</a></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('_pagination', { pagination: typeof pagination !== 'undefined' ? pagination : null }) %>
</div>
</body></html>
