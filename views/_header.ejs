<header class="page-header">
  <div class="page-header__inner">
    <a href="<%= loggedIn ? '/home' : '/login' %>" class="logo" aria-label="Siraj — home">
      <span class="logo-mark" aria-hidden="true">
        <svg class="logo-mark__svg" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="5" y="3" width="24" height="32" rx="2.5" fill="#1e3a8a"/>
          <rect x="9" y="7" width="24" height="32" rx="2.5" fill="#2563eb" stroke="#1d4ed8" stroke-width="1.25"/>
          <path d="M13 14h16M13 19h16M13 24h12" stroke="#bfdbfe" stroke-width="1.75" stroke-linecap="round"/>
          <path d="M13 29h9" stroke="#93c5fd" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="logo-text-group">
        <span class="logo-text">Siraj</span>
        <span class="logo-tagline">Newspaper billing</span>
      </span>
    </a>
    <% if (loggedIn) { %>
    <nav class="page-header__actions" aria-label="Account">
      <a class="header-logout" href="/logout">
        <svg class="header-logout__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign out
      </a>
    </nav>
    <% } %>
  </div>
</header>
