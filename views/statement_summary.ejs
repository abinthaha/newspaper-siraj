<% const monthList = (months || []).join(', '); %>
<% const sorted = [...(months || [])].sort(); %>
<!doctype html>
<html><head><meta charset="utf-8"><title>Statement</title><link rel="stylesheet" href="/styles.css"></head>
<body>
<%- include('_header') %>
<div class="container container--billing-summary">
  <a class="back-link" href="/billing/form#statement">Back to billing &amp; statements</a>
  <h2>Statement</h2>
  <p class="billing-summary__meta">
    <strong><%= frequency.charAt(0).toUpperCase() + frequency.slice(1) %></strong>
    · Months: <strong><%= monthList %></strong>
    <% if (scope === 'customer' && customer) { %>
      · Customer: <strong><%= customer.name %></strong><% if (customer.mobile) { %> (<%= customer.mobile %>)<% } %>
    <% } else if (scope === 'customer') { %>
      · Customer filter #<%= customer && customer.id %>
    <% } else { %>
      · <strong>All customers</strong>
    <% } %>
  </p>
  <p class="billing-summary__note">
    Subscription-months listed: <strong><%= subscriptionMonths %></strong>
    (active subscriptions overlapping each month, <strong>including annual</strong>).
    <strong>Month fee</strong> follows the same rules as billing (catalog rate, Sunday-only, annual = no monthly charge).
    Rows <strong>without</strong> a saved payment line show “—” for invoice / paid / balance unless the subscription is annual (shown as ₹0).
    <strong>Invoice / collected / outstanding</strong> totals below count only rows that already have a payment record for that month.
  </p>

  <section class="billing-summary__totals billing-summary__totals--four" aria-label="Totals">
    <div class="reports-kpi__card">
      <span class="reports-kpi__value">₹<%= Number(totals.periodCharge || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></span>
      <span class="reports-kpi__label">Month fees (all rows)</span>
    </div>
    <div class="reports-kpi__card">
      <span class="reports-kpi__value">₹<%= Number(totals.amountDue || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></span>
      <span class="reports-kpi__label">Invoice totals (payment rows only)</span>
    </div>
    <div class="reports-kpi__card">
      <span class="reports-kpi__value">₹<%= Number(totals.amountPaid || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></span>
      <span class="reports-kpi__label">Total collected (payment rows only)</span>
    </div>
    <div class="reports-kpi__card reports-kpi__card--accent">
      <span class="reports-kpi__value">₹<%= Number(totals.balance || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></span>
      <span class="reports-kpi__label">Total outstanding (payment rows only)</span>
    </div>
  </section>

  <h3 class="billing-summary__table-title">Subscription lines</h3>
  <% if (!rows || !rows.length) { %>
    <% if (typeof pagination !== 'undefined' && pagination && pagination.total > 0) { %>
      <p class="billing-summary__empty">No lines on this page. <a href="<%= pagination.firstUrl %>">Go to first page</a></p>
    <% } else { %>
    <p class="billing-summary__empty">No subscriptions overlapped these months for the selected scope.</p>
    <% } %>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Month</th>
            <th>Customer</th>
            <th>Mobile</th>
            <th>Subscription</th>
            <th>Type</th>
            <th>Month fee</th>
            <th>From prior</th>
            <th>Invoice total</th>
            <th>Paid</th>
            <th>Balance</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (r) { %>
            <% const hasPay = r.id != null && r.id !== ''; %>
            <% const isAnnual = Number(r.subscription_is_annual) === 1; %>
            <% const pcRaw = r.period_charge; %>
            <% const pc = pcRaw == null || pcRaw === '' ? NaN : Number(pcRaw); %>
            <tr>
              <td><%= r.month %></td>
              <td><%= r.customer_name %></td>
              <td><%= r.customer_mobile || '—' %></td>
              <td><%= r.item_name || '—' %></td>
              <td>
                <% if (isAnnual) { %>
                  <span class="badge badge--success">Annual</span>
                <% } else if (Number(r.subscription_is_sunday_only) === 1) { %>
                  <span class="badge badge--neutral">Sunday</span>
                <% } else { %>
                  <span class="badge badge--info">Monthly</span>
                <% } %>
              </td>
              <td><%= Number.isFinite(pc) ? '₹' + pc.toLocaleString(undefined, { maximumFractionDigits: 0 }) : '—' %></td>
              <td><%= r.prior_closing_balance != null ? '₹' + Number(r.prior_closing_balance).toLocaleString(undefined, { maximumFractionDigits: 0 }) : '—' %></td>
              <td>
                <% if (hasPay) { %>
                  ₹<%= Number(r.amount_due || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %>
                <% } else if (isAnnual) { %>
                  ₹0
                <% } else { %>
                  —
                <% } %>
              </td>
              <td>
                <% if (hasPay) { %>
                  ₹<%= Number(r.amount_paid || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %>
                <% } else if (isAnnual) { %>
                  ₹0
                <% } else { %>
                  —
                <% } %>
              </td>
              <td>
                <% if (hasPay) { %>
                  ₹<%= Number(r.balance || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %>
                <% } else if (isAnnual) { %>
                  ₹0
                <% } else { %>
                  —
                <% } %>
              </td>
              <td>
                <% if (hasPay) { %>
                  <a href="/payment/<%= r.id %>">Open</a>
                <% } else { %>
                  —
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('_pagination', { pagination: typeof pagination !== 'undefined' ? pagination : null }) %>
  <% } %>

  <p class="billing-summary__footer">
    <a href="/home">Dashboard</a>
    <span class="billing-summary__dot">·</span>
    <a href="/billing/form#statement">Billing &amp; statements</a>
    <span class="billing-summary__dot">·</span>
    <a href="/reports">Reports</a>
  </p>
</div>
</body></html>
