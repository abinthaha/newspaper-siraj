<!doctype html>
<html><head><meta charset="utf-8"><title>Payments</title><link rel="stylesheet" href="/styles.css"></head>
<body>
<div class="container">
  <a href="/customer/view/<%= customer.id %>">Back</a>
  <h2>Payments for <%= customer.name %></h2>
  <table>
    <tr><th>Month</th><th>Item</th><th>Due</th><th>Paid</th><th>Balance</th><th>Action</th></tr>
    <% payments.forEach(p => { %>
      <tr>
        <td><%= p.month %></td>
        <td><%= p.item_name %></td>
        <td>₹<%= p.amount_due %></td>
        <td>₹<%= p.amount_paid %></td>
        <td>₹<%= p.balance %></td>
        <td><a href="/payment/<%= p.id %>">Open</a></td>
      </tr>
    <% }) %>
  </table>
</div>
</body></html>