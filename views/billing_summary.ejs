<% const monthList = (months || []).join(', '); %>
<% const sorted = [...(months || [])].sort(); %>
<% const exportFrom = sorted[0] || ''; %>
<% const exportTo = sorted[sorted.length - 1] || ''; %>
<% const singleMonth = months && months.length === 1 ? months[0] : null; %>
<% const exportCust = (scope === 'customer' && customer && customer.id) ? customer.id : null; %>
<!doctype html>
<html><head><meta charset="utf-8"><title>Billing summary</title><link rel="stylesheet" href="/styles.css"></head>
<body>
<%- include('_header') %>
<div class="container container--billing-summary">
  <a class="back-link" href="/billing/form">Back to billing</a>
  <h2>Billing run</h2>
  <p class="billing-summary__meta">
    <strong><%= frequency.charAt(0).toUpperCase() + frequency.slice(1) %></strong>
    · Months: <strong><%= monthList %></strong>
    <% if (scope === 'customer' && customer) { %>
      · Customer: <strong><%= customer.name %></strong><% if (customer.mobile) { %> (<%= customer.mobile %>)<% } %>
    <% } else if (scope === 'customer') { %>
      · Customer filter #<%= customer && customer.id %>
    <% } else { %>
      · <strong>All customers</strong>
    <% } %>
  </p>
  <p class="billing-summary__note">
    Subscription-months processed (non-annual): <strong><%= subscriptionMonths %></strong>.
    <strong>Month fee</strong> uses the <strong>item’s current catalog rate</strong> when the subscription is linked to an item (otherwise the rate stored on the subscription). Sunday-only and annual rules match <strong>Generate Billing</strong>. <strong>Invoice total</strong> still includes unpaid balance from earlier months. Re-run billing or open the dashboard to refresh amounts if they were generated with an old item rate.
  </p>

  <section class="billing-summary__totals billing-summary__totals--four" aria-label="Totals">
    <div class="reports-kpi__card">
      <span class="reports-kpi__value">₹<%= Number(totals.periodCharge || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></span>
      <span class="reports-kpi__label">Month fees (subscription charges)</span>
    </div>
    <div class="reports-kpi__card">
      <span class="reports-kpi__value">₹<%= Number(totals.amountDue || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></span>
      <span class="reports-kpi__label">Invoice totals (with balance forward)</span>
    </div>
    <div class="reports-kpi__card">
      <span class="reports-kpi__value">₹<%= Number(totals.amountPaid || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></span>
      <span class="reports-kpi__label">Total collected (rows shown)</span>
    </div>
    <div class="reports-kpi__card reports-kpi__card--accent">
      <span class="reports-kpi__value">₹<%= Number(totals.balance || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></span>
      <span class="reports-kpi__label">Total outstanding (rows shown)</span>
    </div>
  </section>

  <div class="billing-summary__export">
    <span class="billing-summary__export-label">Download this bill data:</span>
    <% if (singleMonth) { %>
      <a href="/export/payments?month=<%= encodeURIComponent(singleMonth) %>&amp;format=csv<% if (exportCust != null) { %>&amp;customer_id=<%= exportCust %><% } %>">CSV</a>
      <span class="billing-summary__dot">·</span>
      <a href="/export/payments?month=<%= encodeURIComponent(singleMonth) %>&amp;format=xlsx<% if (exportCust != null) { %>&amp;customer_id=<%= exportCust %><% } %>">XLSX</a>
    <% } else if (exportFrom && exportTo) { %>
      <a href="/export/payments?from=<%= encodeURIComponent(exportFrom) %>&amp;to=<%= encodeURIComponent(exportTo) %>&amp;format=csv<% if (exportCust != null) { %>&amp;customer_id=<%= exportCust %><% } %>">CSV</a>
      <span class="billing-summary__dot">·</span>
      <a href="/export/payments?from=<%= encodeURIComponent(exportFrom) %>&amp;to=<%= encodeURIComponent(exportTo) %>&amp;format=xlsx<% if (exportCust != null) { %>&amp;customer_id=<%= exportCust %><% } %>">XLSX</a>
    <% } %>
  </div>

  <h3 class="billing-summary__table-title">Payment lines</h3>
  <% if (!rows || !rows.length) { %>
    <p class="billing-summary__empty">No payment rows matched this run (e.g. no overlapping subscriptions for these months).</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Month</th>
            <th>Customer</th>
            <th>Mobile</th>
            <th>Subscription</th>
            <th>Month fee</th>
            <th>From prior</th>
            <th>Invoice total</th>
            <th>Paid</th>
            <th>Balance</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (r) { %>
            <% const bal = Number(r.balance || 0); const paid = Number(r.amount_paid || 0); %>
            <% const pcRaw = r.period_charge; %>
            <% const pc = pcRaw == null || pcRaw === '' ? NaN : Number(pcRaw); %>
            <tr>
              <td><%= r.month %></td>
              <td><%= r.customer_name %></td>
              <td><%= r.customer_mobile || '—' %></td>
              <td><%= r.item_name || '—' %></td>
              <td><%= Number.isFinite(pc) ? '₹' + pc.toLocaleString(undefined, { maximumFractionDigits: 0 }) : '—' %></td>
              <td><%= r.prior_closing_balance != null ? '₹' + Number(r.prior_closing_balance).toLocaleString(undefined, { maximumFractionDigits: 0 }) : '—' %></td>
              <td>₹<%= Number(r.amount_due || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></td>
              <td>₹<%= Number(r.amount_paid || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></td>
              <td>₹<%= Number(r.balance || 0).toLocaleString(undefined, { maximumFractionDigits: 0 }) %></td>
              <td><a href="/payment/<%= r.id %>">Open</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <p class="billing-summary__footer">
    <a href="/home">Dashboard</a>
    <span class="billing-summary__dot">·</span>
    <a href="/reports">Reports</a>
  </p>
</div>
</body></html>
